BasedOnStyle: LLVM
AlwaysBreakTemplateDeclarations: Yes
ColumnLimit: 120
PointerAlignment: Left
QualifierAlignment: Right
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '^".*\.h"'
    Priority:        1
  - Regex:           '^<.*\.h>'
    Priority:        2
  - Regex:           '^<.*>'
    Priority:        3
